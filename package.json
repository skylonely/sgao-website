{
  "name": "sgao-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build && npm run build:offline && node scripts/generate-navigation-sw.mjs",
    "build:offline": "vite build --config vite.offline.config.ts",
    "build:static": "vite build --config vite.static.config.ts && vite build --config vite.offline.config.ts --mode static-preview && node scripts/generate-navigation-sw.mjs --output=dist-static",
    "preview:static": "vite preview --config vite.static.config.ts",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "navigation:test": "node --test tests/navigation-account.test.mjs",
    "backup:test": "node --test tests/navigation-backup.test.mjs",
    "edit:test": "node --test tests/navigation-edit.test.mjs",
    "pwa:test": "npm run build && node --test tests/navigation-pwa.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "travel:dev": "vitepress dev travel",
    "travel:build": "vitepress build travel",
    "travel:preview": "vitepress preview travel",
    "todo:dev": "vitepress dev todo",
    "todo:build": "vitepress build todo && node scripts/generate-todo-sw.mjs",
    "todo:preview": "vitepress preview todo",
    "todo:test": "npm run todo:build && node --test tests/todo-checklist-ids.test.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "mermaid": "11.16.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "2.0.17",
    "vue": "^3.5.40",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
